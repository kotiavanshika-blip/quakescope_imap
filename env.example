# Copy this file to ".env" to change settings. The real ".env" is ignored by git.
# None of the services in this project need an API key (USGS is open).
# If you ever add a key, put it in .env and NEVER commit it.

# How long (seconds) an answer from USGS is reused before we ask USGS again.
CACHE_SECONDS=60

# Grafana admin password (only needed if you log in to edit the dashboard).
GRAFANA_PASSWORD=admin
